# Configure these in the deployment environment or secret manager, not in the mobile app.
IDENTITY_VERIFICATION_ENABLED=true
FACE_LIVENESS_ENABLED=true
FACE_LIVENESS_LAMBDA_URL=https://<lambda-url>.lambda-url.<region>.on.aws/
FACE_LIVENESS_SHARED_SECRET=<random-secret-matching-LINEALILA_SERVICE_KEY>
FACE_LIVENESS_TICKET_SECRET=<at-least-32-random-characters-for-biometric-tickets>
FACE_LIVENESS_MIN_CONFIDENCE=<set-after-validation>
FACE_MATCH_MIN_CONFIDENCE=<set-after-validation>

# Database (set real secrets only in local .env or the deployment secret manager)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=linea_lila
DB_USER=postgres
DB_PASSWORD=<set-locally>
DB_SSL=false
DATABASE_URL=<set-in-production-secret-manager>
