{
  "name": "linea-lila-backend",
  "version": "1.0.0",
  "description": "Backend API para LineaLila - Aplicación de transporte",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node migrate.js",
    "migrate:tic": "node src/scripts/addTicDocumentType.js",
    "migrate:driver-request-status": "node src/scripts/addObservedDriverRequestStatus.js",
    "migrate:domicile": "node src/scripts/addDomicileProofDocumentType.js",
    "migrate:driver-domiciles": "node src/scripts/createDriverDomiciles.js",
    "migrate:remove-retired": "node src/scripts/removeRetiredSchema.js",
    "seed": "node src/seeders/seeder.js",
    "seed:test-driver": "node src/seeders/test-driver.js",
    "test:identity": "node --test src/services/__tests__/identityValidation.test.js src/services/__tests__/identityEvidence.test.js src/services/__tests__/legacyCi.test.js",
    "test:identity:db": "node --test src/services/__tests__/identitySessions.integration.test.js",
    "test:parsers": "node src/scripts/testParsers.js",
    "fixtures:geo": "node src/scripts/buildGeometryFixtures.js",
    "migrate:quick": "node src/scripts/migrateQuickAssignment.js",
    "test:quick": "node --test src/services/__tests__/quickAssignment.test.js src/services/__tests__/assignmentRouting.test.js src/services/__tests__/quickAssignment.integration.test.js",
    "test:places": "node --test src/services/__tests__/placesService.test.js"
  },
  "keywords": [
    "transport",
    "rides",
    "postgresql",
    "sequelize"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google-cloud/vision": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "firebase-admin": "^13.7.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "pg": "^8.10.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "sharp": "^0.35.3",
    "socket.io": "^4.6.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5"
  }
}
