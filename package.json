{
  "name": "linea-lila-backend",
  "version": "1.0.0",
  "description": "Backend API para LineaLila - Aplicación de transporte",
  "main": "src/servidor.js",
  "scripts": {
    "start": "node src/servidor.js",
    "dev": "nodemon src/servidor.js",
    "migrate": "node migrate.js",
    "seed": "node src/seeders/seeder.js",
    "seed:zonas": "node seeders/02-service-areas.js",
    "seed:test-driver": "node src/seeders/test-conductor.js",
    "test:identity": "node --test src/services/__tests__/identidadValidacion.test.js src/services/__tests__/identidadEvidencia.test.js src/services/__tests__/antiguoCi.test.js",
    "test:identity:db": "node --test src/services/__tests__/identidadSessions.integration.test.js",
    "test:parsers": "node src/scripts/testAnalizadores.js",
    "fixtures:geo": "node src/scripts/buildGeometriaFixtures.js",
    "test:quick": "node --test src/services/__tests__/rapidaAsignacion.test.js src/services/__tests__/asignacionRouting.test.js src/services/__tests__/rapidaAsignacion.integration.test.js",
    "test:places": "node --test src/services/__tests__/placesServicio.test.js",
    "test:esquema-espanol": "node --test src/services/__tests__/esquemaEspanol.test.js"
